module HTTParty
end

module Prescient
  VERSION: String

  class Error < StandardError
    attr_reader provider: String?
    attr_reader operation: String?
    attr_reader status: Integer?

    def initialize: (?String?, ?provider: String?, ?operation: String?, ?status: Integer?) -> void
  end

  class ConnectionError < Error
  end

  class AuthenticationError < Error
  end

  class RateLimitError < Error
  end

  class ModelNotAvailableError < Error
  end

  class InvalidResponseError < Error
  end

  class InvalidVectorError < Error
  end

  class ProviderError < Error
  end

  class ToolError < Error
  end

  class ToolConfigurationError < ToolError
  end

  class ToolConnectionError < ToolError
  end

  class ToolInvalidResponseError < ToolError
  end

  module Tool
    class Base
      DEFAULT_TIMEOUT: Integer
      DEFAULT_MAX_RESULTS: Integer
      MAX_QUERY_LENGTH: Integer
      DEFAULT_MAX_RESPONSE_BYTES: Integer

      attr_reader options: Hash[Symbol, untyped]

      def initialize: (**untyped) -> void
      def search: (String, **untyped) -> Hash[Symbol, untyped]
    end

    class Group < Base
      attr_reader adapters: Array[Base]
      def initialize: (adapters: Array[Base]) -> void
      def search: (String, **untyped) -> Hash[Symbol, untyped]
    end

    class SearXNG < Base
      def initialize: (**untyped) -> void
      def search: (String, ?limit: Integer?, ?timeout: Numeric?) -> Hash[Symbol, untyped]
    end

    class SearchApi < Base
      API_URL: String
      def initialize: (**untyped) -> void
      def search: (String, ?limit: Integer?, ?timeout: Numeric?) -> Hash[Symbol, untyped]
    end
  end

  module DocumentSource
    DEFAULT_MAX_DOCUMENTS: Integer
    DEFAULT_MAX_BYTES: Integer

    class Base
      def initialize: (?max_documents: Integer, ?max_bytes: Integer) -> void
      def fetch: () -> Array[Hash[String, untyped]]
    end

    class Memory < Base
      def initialize: (documents: Array[Hash[String, untyped]] | Hash[String, untyped], ?max_documents: Integer, ?max_bytes: Integer) -> void
      def fetch: () -> Array[Hash[String, untyped]]
    end

    class JsonFile < Base
      def initialize: (path: String, ?max_documents: Integer, ?max_bytes: Integer) -> void
      def fetch: () -> Array[Hash[String, untyped]]
    end

    class RedisJson < Base
      def initialize: (client: untyped, key: String, ?max_documents: Integer, ?max_bytes: Integer) -> void
      def fetch: () -> Array[Hash[String, untyped]]
    end
  end

  module Agent
    class Error < Prescient::Error
    end
    class ConfigurationError < Error
    end
    class MalformedActionError < Error
    end
    class UnauthorizedToolError < Error
    end
    class MaxLoopsExceededError < Error
    end

    class ErrorSerializer
      def self.serialize: (Exception) -> Hash[Symbol, untyped]
    end

    class Configuration
      DEFAULT_MAX_LOOPS: Integer
      DEFAULT_MAX_CONTEXT_BYTES: Integer
      DEFAULT_MAX_ACTION_BYTES: Integer
      DEFAULT_MAX_OBSERVATION_BYTES: Integer

      attr_reader max_loops: Integer
      attr_reader max_context_bytes: Integer
      attr_reader max_action_bytes: Integer
      attr_reader max_observation_bytes: Integer

      attr_reader authorization: Proc?
      attr_reader telemetry: Proc?
      def initialize: (?max_loops: Integer, ?max_context_bytes: Integer, ?max_action_bytes: Integer, ?max_observation_bytes: Integer, ?authorization: Proc?, ?telemetry: Proc?) -> void
    end

    class Context
      attr_reader messages: Array[Hash[Symbol, String]]
      def initialize: (system_prompt: String, task: String, ?max_bytes: Integer) -> void
      def append: (role: String, content: String) -> void
      def to_a: () -> Array[Hash[Symbol, String]]
    end

    class Parser
      ACTION_PATTERN: Regexp
      def self.parse: (String, ?max_bytes: Integer) -> Hash[Symbol, untyped]?
      def initialize: (?max_bytes: Integer) -> void
      def parse: (String) -> Hash[Symbol, untyped]?
    end

    class PromptBuilder
      def self.build: (system_instruction: String, tools: Array[ToolRegistry::Tool]) -> String
    end

    class ToolRegistry
      class Tool
        attr_reader name: Symbol
        attr_reader description: String
        attr_reader schema: Hash[untyped, untyped]
        attr_reader callable: Proc
      end

      def initialize: (Hash[Symbol | String, untyped]) -> void
      def all: () -> Array[Tool]
      def invoke: (Symbol | String, Hash[String | Symbol, untyped]) -> untyped
    end

    class Result
      attr_reader response: String
      attr_reader provider: Symbol | String | nil
      attr_reader model: String | nil
      attr_reader loops_run: Integer
      attr_reader metadata: Hash[untyped, untyped]
      def initialize: (response: String, provider: Symbol | String | nil, model: String | nil, loops_run: Integer, ?success: bool, ?metadata: Hash[untyped, untyped]) -> void
      def success?: () -> bool
      def to_h: () -> Hash[Symbol, untyped]
    end

    class Runtime
      def initialize: (?provider: Symbol?, ?client: untyped, ?tools: Hash[Symbol | String, untyped]?, ?tool_names: Array[Symbol | String], ?configuration: Configuration, ?system_prompt: String, ?provider_options: Hash[Symbol, untyped], ?generation_options: Hash[Symbol, untyped], ?authorization: Proc?, ?telemetry: Proc?, ?request_context: Hash[Symbol, untyped]) -> void
      def run: (String) -> Result
    end
  end

  module MCP
    class Configuration
      DEFAULT_MAX_INPUT_BYTES: Integer
      DEFAULT_TOOLS: Array[String]
      SUPPORTED_RESOURCES: Array[String]
      attr_reader name: String
      attr_reader version: String
      attr_reader max_input_bytes: Integer
      attr_reader tools: Array[String]
      attr_reader resources: Array[String]
      def initialize: (?name: String, ?version: String, ?max_input_bytes: Integer, ?tools: Array[String], ?resources: Array[String]) -> void
    end

    class Server
      def initialize: (?configuration: Configuration, ?client_factory: Proc?, ?authorization: Proc?) -> void
      def initialize_result: () -> Hash[Symbol, untyped]
      def tools: () -> Array[Hash[String, untyped]]
      def resources: () -> Array[Hash[String, untyped]]
      def call_tool: (String | Symbol, ?Hash[String, untyped], ?context: Hash[Symbol, untyped]) -> Hash[Symbol, untyped]
      def read_resource: (String | Symbol) -> Hash[Symbol, untyped]
    end

    class Stdio
      def initialize: (?server: Server, ?input: untyped, ?output: untyped) -> void
      def run: () -> void
    end
  end

  class Base
    attr_reader options: Hash[Symbol, untyped]
    attr_reader provider_name: String

    def initialize: (**untyped) -> void
    def generate_embedding: (String, **untyped) -> Array[Float]
    def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
    def health_check: () -> Hash[Symbol, untyped]
    def available?: () -> bool

    def validate_configuration!: () -> void
    def handle_errors: () { () -> untyped } -> untyped
    def validate_embedding_dimensions: (untyped, Integer) -> Array[untyped]
    def clean_text: (untyped) -> String
    def default_prompt_templates: () -> Hash[Symbol, String]
    def build_prompt: (String, ?Array[untyped]) -> String
    def default_context_configs: () -> Hash[untyped, untyped]
    def extract_embedding_text: (untyped, ?String) -> String
    def extract_text_values: (Hash[untyped, untyped]) -> Array[String]
    def format_context_item: (untyped) -> String

    private

    def resolve_context_config: (untyped, String?) -> Hash[untyped, untyped]
    def extract_configured_fields: (Hash[untyped, untyped], Hash[untyped, untyped]) -> Array[untyped]?
    def format_hash_item: (Hash[untyped, untyped]) -> String
    def build_format_data: (Hash[untyped, untyped], Hash[untyped, untyped]) -> Hash[Symbol, untyped]
    def apply_format_template: (String, Hash[Symbol, untyped]) -> String?
    def detect_context_type: (untyped) -> String
    def match_context_by_fields: (Hash[untyped, untyped], Hash[untyped, untyped]) -> String
    def find_best_field_match: (Array[String], Hash[untyped, untyped]) -> String?
    def calculate_field_match_score: (Array[String], Array[String]) -> Numeric
    def fallback_format_hash: (Hash[untyped, untyped], ?Hash[Symbol, untyped]) -> String
    def validate_response!: (untyped, String) -> void
    def provider_error: (String, untyped, operation: String, ?provider: untyped, ?error_class: untyped) -> Error
  end

  module Provider
    class Ollama < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> Array[Float]
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def available_models: () -> Array[Hash[Symbol, untyped]]
      def pull_model: (String) -> Hash[Symbol, untyped]

      private

      def validate_configuration!: () -> void
      def prepare_generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def fetch_and_parse: (String, String, **untyped) -> untyped
      def validate_response!: (untyped, String) -> void
    end

    class Anthropic < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> untyped
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def api_headers: () -> Hash[String, String]
      def validate_response!: (untyped, String) -> void
    end

    class OpenAI < Base
      EMBEDDING_DIMENSIONS: Hash[String, Integer]

      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> Array[Float]
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def validate_response!: (untyped, String) -> void
      def provider_error: (String, untyped, operation: String, ?provider: untyped, ?error_class: untyped) -> Error
    end

    class HuggingFace < Base
      FEATURE_EXTRACTION_PATH: String
      CHAT_COMPLETIONS_PATH: String
      MODEL_LIST_PATH: String
      EMBEDDING_DIMENSIONS: Hash[String, Integer]

      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> Array[Float]
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def validate_response!: (untyped, String) -> void
    end

    class Gemini < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> Array[Float]
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def api_headers: () -> Hash[String, String]
      def model_endpoint: (untyped, String) -> String
      def find_model: (Array[untyped], untyped, String) -> bool
    end

    class Mistral < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> Array[Float]
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def api_headers: () -> Hash[String, String]
      def model_available?: (Array[untyped], untyped) -> bool
      def normalize_content: (untyped) -> String?
    end

    class DeepSeek < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> untyped
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def api_headers: () -> Hash[String, String]
    end

    class XAI < Base
      def self.base_uri: (String) -> untyped
      def self.default_timeout: (Integer) -> untyped
      def self.get: (String, **untyped) -> untyped
      def self.post: (String, **untyped) -> untyped

      def initialize: (**untyped) -> void
      def generate_embedding: (String, **untyped) -> untyped
      def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
      def health_check: () -> Hash[Symbol, untyped]
      def list_models: () -> Array[Hash[Symbol, untyped]]

      private

      def validate_configuration!: () -> void
      def api_headers: () -> Hash[String, String]
    end
  end

  module Pgvector
    class Store
      METRICS: Hash[Symbol, String]

      attr_reader dimensions: Integer
      attr_reader table: String

      def initialize: (connection: untyped, dimensions: Integer, ?table: String | Symbol) -> void
      def install!: () -> void
      def create_index!: (?metric: Symbol) -> void
      def upsert: (id: untyped, embedding: Array[Numeric], provider: untyped, model: untyped, ?content: String?, ?metadata: Hash[untyped, untyped]) -> Hash[Symbol, untyped]
      def search: (embedding: Array[Numeric], ?limit: Integer, ?metric: Symbol, ?provider: String | Symbol?, ?model: String?) -> Array[Hash[Symbol, untyped]]
    end
  end

  class Configuration
    DEFAULT_SENSITIVE_KEYS: Array[Symbol]

    attr_accessor default_provider: Symbol
    attr_accessor timeout: Integer
    attr_accessor retry_attempts: Integer
    attr_accessor retry_delay: Float
    attr_accessor fallback_providers: Array[Symbol]
    attr_reader sensitive_keys: Array[Symbol]
    attr_reader providers: Hash[Symbol, Hash[Symbol, untyped]]
    attr_reader tools: Hash[Symbol, Hash[Symbol, untyped]]

    def initialize: () -> void
    def sensitive_keys=: (Array[Symbol | String]) -> Array[Symbol]
    def add_provider: (Symbol | String, Class, **untyped) -> void
    def provider: (Symbol | String) -> untyped
    def add_tool: (Symbol | String, Class, **untyped) -> void
    def add_tool_group: (Symbol | String, Array[Hash[Symbol, untyped]]) -> void
    def tool: (Symbol | String) -> untyped
    def available_providers: () -> Array[Symbol]
  end

  class Client
    attr_reader provider_name: Symbol
    attr_reader provider: untyped

    def initialize: (?Symbol, ?enable_fallback: bool, ?provider_options: Hash[Symbol, untyped]) -> void
    def generate_embedding: (String, **untyped) -> Array[Float]
    def generate_response: (String, ?Array[untyped], **untyped) -> Hash[Symbol, untyped]
    def health_check: () -> Hash[Symbol, untyped]
    def available?: () -> bool
    def provider_info: () -> Hash[Symbol, untyped]

    private

    def sanitize_options: (Hash[untyped, untyped]) -> Hash[untyped, untyped]
    def provider_with_options: (Symbol, Hash[Symbol, untyped]) -> untyped
    def with_error_handling: () { () -> untyped } -> untyped
    def with_fallback_handling: (Symbol, *untyped, **untyped) -> untyped
    def provider_for: (Symbol, Integer) -> untyped
    def providers_to_try: () -> Array[Symbol]
    def fallback_eligible?: (Error) -> bool
  end

  class CLI
    FORMATS: Array[String]

    class UsageError < StandardError
    end

    def self.run: (Array[String], ?input: IO, ?output: IO, ?errors: IO) -> Integer
    def initialize: (Array[String], input: IO, output: IO, errors: IO) -> void
    def run: () -> Integer
  end

  class API
    DEFAULT_MAX_BODY_BYTES: Integer
    MAX_BATCH_SIZE: Integer
    API_VERSION: String
    ROUTES: Hash[Array[String], Symbol]

    def initialize: (?authentication: untyped, ?max_body_bytes: Integer) -> void
    def call: (Hash[String, untyped]) -> [Integer, Hash[String, String], Array[String]]
  end

  class ConfigurationLoader
    CONFIGURATION_VERSION: Integer
    TOP_LEVEL_KEYS: Array[String]
    PROVIDER_TYPES: Hash[String, untyped]
    COMMON_PROVIDER_KEYS: Array[String]
    TOOL_TYPES: Hash[String, untyped]
    COMMON_TOOL_KEYS: Array[String]
    PROMPT_TEMPLATE_KEYS: Array[String]
    ATTR_KEYS: Array[String]

    def self.load_file: (String, ?env: untyped) -> Configuration
    def self.load_yaml: (String, ?env: untyped) -> Configuration
    def self.load_hash: (Hash[untyped, untyped], ?env: untyped) -> Configuration
    def self.schema_path: () -> String

    def initialize: (?untyped) -> void
    def load_file: (String) -> Configuration
    def load_yaml: (String, ?source: String?) -> Configuration
    def load_hash: (untyped, ?source: String?) -> Configuration
    def apply!: (Configuration, untyped, ?source: String?) -> Configuration
  end

  def self.configure: () { (Configuration) -> void } -> void
  def self.configuration: () -> Configuration
  def self.reset_configuration!: () -> Configuration
  def self.load_configuration: (?String?, ?env: untyped) -> Configuration
  def self.client: (?Symbol, ?enable_fallback: bool, ?provider_options: Hash[Symbol, untyped]) -> Client
  def self.generate_embedding: (String, ?provider: Symbol, ?enable_fallback: bool, **untyped) -> Array[Float]
  def self.generate_response: (String, ?Array[untyped], ?provider: Symbol, ?enable_fallback: bool, **untyped) -> Hash[Symbol, untyped]
  def self.search_and_generate: (String, ?tool: Symbol | String, ?provider: Symbol, ?limit: Integer?, ?enable_fallback: bool, ?provider_options: Hash[Symbol, untyped], **untyped) -> Hash[Symbol, untyped]
  def self.health_check: (?provider: Symbol) -> Hash[Symbol, untyped]
  def self.tool: (Symbol | String) -> untyped

  private

  def self.configure_default_providers: (Configuration, untyped) -> void
  def self.configure_default_tools: (Configuration, untyped) -> void
  def self.configure_ollama: (Configuration, untyped) -> void
  def self.configure_openai: (Configuration, untyped) -> void
  def self.configure_anthropic: (Configuration, untyped) -> void
  def self.configure_gemini: (Configuration, untyped) -> void
  def self.configure_mistral: (Configuration, untyped) -> void
  def self.configure_deepseek: (Configuration, untyped) -> void
  def self.configure_xai: (Configuration, untyped) -> void
  def self.configure_huggingface: (Configuration, untyped) -> void
end
