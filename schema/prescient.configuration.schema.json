{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kanutocd/prescient/schema/prescient.configuration.schema.json",
  "title": "Prescient Configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "default_provider": {
      "type": "string"
    },
    "default_provider_env": {
      "type": "string"
    },
    "timeout": {
      "type": "number"
    },
    "timeout_env": {
      "type": "string"
    },
    "retry_attempts": {
      "type": "integer"
    },
    "retry_attempts_env": {
      "type": "string"
    },
    "retry_delay": {
      "type": "number"
    },
    "retry_delay_env": {
      "type": "string"
    },
    "fallback_providers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fallback_providers_env": {
      "type": "string"
    },
    "sensitive_keys": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensitive_keys_env": {
      "type": "string"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/provider"
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/tool"
      }
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ollama",
            "anthropic",
            "openai",
            "huggingface",
            "gemini",
            "mistral",
            "deepseek",
            "xai"
          ]
        },
        "api_key": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "url_env": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "model_env": {
          "type": "string"
        },
        "chat_model": {
          "type": "string"
        },
        "chat_model_env": {
          "type": "string"
        },
        "embedding_model": {
          "type": "string"
        },
        "embedding_model_env": {
          "type": "string"
        },
        "embedding_dimensions": {
          "type": "integer"
        },
        "embedding_dimensions_env": {
          "type": "string"
        },
        "timeout": {
          "type": "number"
        },
        "timeout_env": {
          "type": "string"
        },
        "context_configs": {
          "type": "object"
        },
        "context_configs_env": {
          "type": "string"
        },
        "prompt_templates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "system_prompt": {
              "type": "string"
            },
            "no_context_template": {
              "type": "string"
            },
            "with_context_template": {
              "type": "string"
            }
          }
        },
        "prompt_templates_env": {
          "type": "string"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "searxng",
            "searchapi"
          ]
        },
        "api_key": {
          "type": "string"
        },
        "api_key_env": {
          "type": "string"
        },
        "engine": {
          "type": "string"
        },
        "engine_env": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "location_env": {
          "type": "string"
        },
        "hl": {
          "type": "string"
        },
        "hl_env": {
          "type": "string"
        },
        "gl": {
          "type": "string"
        },
        "gl_env": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri-reference"
        },
        "url_env": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "language_env": {
          "type": "string"
        },
        "categories": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "categories_env": {
          "type": "string"
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeout_env": {
          "type": "string"
        },
        "max_results": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "max_results_env": {
          "type": "string"
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_response_bytes_env": {
          "type": "string"
        }
      }
    }
  }
}
